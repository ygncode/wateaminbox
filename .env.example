# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/whatsapp_web

# NATS
NATS_URL=nats://localhost:4222

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=development_master_key

# MinIO (S3-compatible storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=whatsapp-media
S3_REGION=us-east-1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
NODE_ENV=development

# Message Cleanup Service
# Enable/disable automatic cleanup of stale pending messages
MESSAGE_CLEANUP_ENABLED=true
# Minutes before a pending message is considered timed out (default: 5)
MESSAGE_CLEANUP_TIMEOUT_MINUTES=5
# Minutes between cleanup cycles (default: 1)
MESSAGE_CLEANUP_INTERVAL_MINUTES=1
# Number of messages to process per batch per tenant (default: 100)
MESSAGE_CLEANUP_BATCH_SIZE=100
