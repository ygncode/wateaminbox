# Docker Compose
COMPOSE_PROJECT_NAME=wateaminbox

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:4447/wateaminbox?sslmode=disable

# NATS
NATS_URL=nats://localhost:4448

# Orchestrator operational HTTP API (a bearer token is required for non-loopback HTTP_ADDR)
HTTP_ADDR=127.0.0.1:8080
HTTP_BEARER_TOKEN=

# Meilisearch
MEILISEARCH_URL=http://localhost:4449
MEILISEARCH_API_KEY=development_master_key

# S3-compatible media storage. Local development uses MinIO. Production R2 uses
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com with region=auto.
S3_ENDPOINT=http://localhost:4450
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=whatsapp-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_LEGACY_ENDPOINTS=
S3_SIGNED_URL_TTL_SECONDS=300
# Bucket creation is disabled by default; Compose initializes local MinIO.
STORAGE_CREATE_BUCKET_IF_MISSING=false

# JWT
# Required in every environment - the API ships no default and refuses to
# start without it. HS256 accepts a zero-length key, and a key committed to
# this repository would be no better, so either would leave every issued token
# forgeable. Generate your own:
#
#   openssl rand -base64 48
#
# `./dev-start.sh` generates and records one automatically if this is blank.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email transport: "log" for local capture, "resend" or "cloudflare" for
# delivery. Only the selected provider's credentials are read, so leave the
# other one blank instead of inventing a value for it.
MAIL_DRIVER=log
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Cloudflare Email Service (MAIL_DRIVER=cloudflare). The token needs the
# Email Sending: Edit permission on the account that owns the sender domain,
# and that domain must be onboarded for Email Sending on Cloudflare DNS.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM="WATeamInbox <noreply@example.com>"

# App
APP_URL=http://localhost:4444
API_URL=http://localhost:4445
CORS_ORIGINS=http://localhost:4444,http://localhost:3000
NODE_ENV=development

# Centrifugo (replace both secrets in production)
CENTRIFUGO_API_URL=http://localhost:4451/api
CENTRIFUGO_HEALTH_URL=http://localhost:4451/health
CENTRIFUGO_API_KEY=development-centrifugo-api-key
# Required in every environment, for the same reason as JWT_SECRET: this key
# signs the tokens that authorize realtime channel subscriptions. Generate your
# own with `openssl rand -base64 48`; `./dev-start.sh` fills it in if blank.
# docker compose reads this same file, so the Centrifugo container picks up
# whatever value you set here.
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_REQUEST_TIMEOUT_MS=3000
# Realtime fan-out tuning. Membership is cached between conversation events and
# invalidated on every company_members write, so a revocation applies on the
# next event; the TTL only bounds staleness on OTHER API replicas. Set 0 to
# always read live. The interval collapses repeated identical typing/presence
# signals; a state change is never suppressed.
REALTIME_MEMBERSHIP_CACHE_TTL_MS=5000
REALTIME_EPHEMERAL_MIN_INTERVAL_MS=1500

# Centrifugo browser WebSocket endpoint
VITE_CENTRIFUGO_URL=ws://localhost:4451/connection/websocket

# Web Push (optional; generate keys with `bunx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
# Same public key as VAPID_PUBLIC_KEY; exposed to the browser by Vite.
VITE_VAPID_PUBLIC_KEY=

# Shared tenant database pool
TENANT_DB_POOL_MAX=20

# Message Cleanup Service
# Enable/disable automatic cleanup of stale pending messages
MESSAGE_CLEANUP_ENABLED=true
# Minutes before a pending message is considered timed out (default: 5)
MESSAGE_CLEANUP_TIMEOUT_MINUTES=5
# Minutes between cleanup cycles (default: 1)
MESSAGE_CLEANUP_INTERVAL_MINUTES=1
# Number of messages to process per batch per tenant (default: 100)
MESSAGE_CLEANUP_BATCH_SIZE=100

# Rate Limiting
# Enable/disable rate limiting globally (set to "false" to disable entirely)
RATE_LIMIT_ENABLED=true
# Rate limit store type: "memory" for in-memory LRU cache, "redis" for distributed
RATE_LIMIT_STORE_TYPE=memory
# Redis connection URL (required when RATE_LIMIT_STORE_TYPE=redis)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Maximum number of items in memory LRU cache (default: 10000)
RATE_LIMIT_MEMORY_MAX_ITEMS=10000
# Exact direct-peer IPs allowed to supply the configured client IP header.
# Leave empty for direct deployments so forwarding headers are ignored.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_IP_HEADER=x-forwarded-for

# Rate Limit: Global Tier (applies to all /api/* routes)
# Global requests per rolling window (default: 100)
RATE_LIMIT_GLOBAL_REQUESTS=100
# Global window duration in seconds (default: 60)
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Rate Limit: Auth Endpoints
# Login attempts per rolling window (default: 5, prevents brute force)
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
# Login window duration in seconds (default: 900 = 15 minutes)
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=900
# Registration attempts per rolling window (default: 3, prevents spam accounts)
RATE_LIMIT_AUTH_REGISTER_REQUESTS=3
# Registration window duration in seconds (default: 3600 = 1 hour)
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
# Verification resend attempts per rolling window (default: 3)
RATE_LIMIT_AUTH_RESEND_VERIFICATION_REQUESTS=3
# Verification resend window duration in seconds (default: 3600 = 1 hour)
RATE_LIMIT_AUTH_RESEND_VERIFICATION_WINDOW_SECONDS=3600
# Forgot password attempts per rolling window (default: 3, prevents email enumeration)
RATE_LIMIT_AUTH_FORGOT_PASSWORD_REQUESTS=3
# Forgot password window duration in seconds (default: 3600 = 1 hour)
RATE_LIMIT_AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=3600
# Token refresh requests per rolling window (default: 20)
RATE_LIMIT_AUTH_REFRESH_REQUESTS=20
# Refresh window duration in seconds (default: 60 = 1 minute)
RATE_LIMIT_AUTH_REFRESH_WINDOW_SECONDS=60

# Rate Limit: Resource-Intensive Endpoints
# Search requests per rolling window (default: 30)
RATE_LIMIT_RESOURCE_SEARCH_REQUESTS=30
# Search window duration in seconds (default: 60)
RATE_LIMIT_RESOURCE_SEARCH_WINDOW_SECONDS=60
# Export requests per rolling window (default: 10, very restrictive for CPU-intensive operations)
RATE_LIMIT_RESOURCE_EXPORT_REQUESTS=10
# Export window duration in seconds (default: 3600 = 1 hour)
RATE_LIMIT_RESOURCE_EXPORT_WINDOW_SECONDS=3600
# Bulk import requests per rolling window (default: 5)
RATE_LIMIT_RESOURCE_IMPORT_REQUESTS=5
# Import window duration in seconds (default: 60)
RATE_LIMIT_RESOURCE_IMPORT_WINDOW_SECONDS=60
# Analytics requests per rolling window (default: 20, prevents heavy aggregation query abuse)
RATE_LIMIT_RESOURCE_ANALYTICS_REQUESTS=60
# Analytics window duration in seconds (default: 60)
RATE_LIMIT_RESOURCE_ANALYTICS_WINDOW_SECONDS=60

# Rate Limit: Messaging Endpoints
# Message send requests per rolling window (default: 60, allows reasonable burst)
RATE_LIMIT_MESSAGING_SEND_REQUESTS=60
# Message send window duration in seconds (default: 60)
RATE_LIMIT_MESSAGING_SEND_WINDOW_SECONDS=60
# WhatsApp API requests per rolling window (default: 30)
RATE_LIMIT_MESSAGING_WHATSAPP_REQUESTS=30
# WhatsApp window duration in seconds (default: 60)
RATE_LIMIT_MESSAGING_WHATSAPP_WINDOW_SECONDS=60
# Bulk broadcast API requests per rolling window (default: 10)
RATE_LIMIT_MESSAGING_BULK_REQUESTS=10
# Bulk broadcast window duration in seconds (default: 60)
RATE_LIMIT_MESSAGING_BULK_WINDOW_SECONDS=60

# Bulk Broadcasts
# Gap between bulk sends on one WhatsApp connection in ms (default: 12000, hard minimum 5000)
BULK_SEND_INTERVAL_MS=12000
# Recipient cap per broadcast job (default: 100, hard maximum 500)
BULK_MAX_RECIPIENTS_PER_JOB=100
# Bulk sends per connection per day (default: 200, hard maximum 1000)
BULK_DAILY_CAP_PER_CONNECTION=200
