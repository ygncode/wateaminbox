{
  "name": "@whatsapp-web/database",
  "version": "0.0.1",
  "private": true,
  "description": "Database client and migrations for WhatsApp Web",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "db:migrate": "kysely migrate:latest",
    "db:generate": "kysely-codegen --out-file ./src/types/database.ts"
  },
  "dependencies": {
    "kysely": "^0.27.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3",
    "tsup": "^8.0.1",
    "kysely-codegen": "^0.11.0"
  }
}
