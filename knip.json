{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "apps/api": {
      "entry": ["src/index.ts", "src/scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/database": {
      "entry": [
        "src/migrations/*.ts",
        "src/**/*.test.ts",
        "src/preflight-*.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/adapter-telegram": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": ["kysely", "pg", "ioredis", "nats"],
  "ignoreBinaries": ["go"],
  "ignoreExportsUsedInFile": true,
  "exclude": ["enumMembers", "exports", "types"]
}
