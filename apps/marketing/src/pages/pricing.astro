---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - WhatsApp Web">
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Pricing</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Choose the plan that works best for you
      </p>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-3">
      <!-- Free Plan -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">Free</h3>
        <p class="mt-2 text-gray-600">For personal use</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-gray-900">$0</span>
          <span class="text-gray-600">/month</span>
        </p>
        <ul class="mt-8 space-y-4 text-gray-600">
          <li>Unlimited messages</li>
          <li>Basic features</li>
          <li>Community support</li>
        </ul>
        <a
          href="#"
          class="mt-8 block w-full rounded-lg border border-gray-300 bg-white py-3 text-center font-semibold text-gray-700 hover:bg-gray-50"
        >
          Get Started
        </a>
      </div>

      <!-- Pro Plan -->
      <div class="relative rounded-2xl border-2 border-primary-600 bg-white p-8 shadow-sm">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary-600 px-4 py-1 text-sm font-semibold text-white">
          Popular
        </span>
        <h3 class="text-lg font-semibold text-gray-900">Pro</h3>
        <p class="mt-2 text-gray-600">For professionals</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-gray-900">$9</span>
          <span class="text-gray-600">/month</span>
        </p>
        <ul class="mt-8 space-y-4 text-gray-600">
          <li>Everything in Free</li>
          <li>Priority support</li>
          <li>Advanced features</li>
          <li>API access</li>
        </ul>
        <a
          href="#"
          class="mt-8 block w-full rounded-lg bg-primary-600 py-3 text-center font-semibold text-white hover:bg-primary-700"
        >
          Get Started
        </a>
      </div>

      <!-- Enterprise Plan -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">Enterprise</h3>
        <p class="mt-2 text-gray-600">For large teams</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-gray-900">Custom</span>
        </p>
        <ul class="mt-8 space-y-4 text-gray-600">
          <li>Everything in Pro</li>
          <li>Dedicated support</li>
          <li>Custom integrations</li>
          <li>SLA guarantee</li>
        </ul>
        <a
          href="#"
          class="mt-8 block w-full rounded-lg border border-gray-300 bg-white py-3 text-center font-semibold text-gray-700 hover:bg-gray-50"
        >
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</Layout>
