---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - WATeamInbox">
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Simple, transparent pricing</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        WhatsApp for teams. No hidden fees, no surprises.
      </p>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-3">
      <!-- Monthly Plan -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">Monthly</h3>
        <p class="mt-2 text-gray-600">For teams getting started</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-gray-900">$50</span>
          <span class="text-gray-600">/month</span>
        </p>
        <ul class="mt-8 space-y-4 text-gray-600">
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Unlimited team members
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Unlimited messages
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            5 WhatsApp numbers
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Contact assignment
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Team collaboration
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Analytics dashboard
          </li>
        </ul>
        <a
          href="#"
          class="mt-8 block w-full rounded-lg border border-gray-300 bg-white py-3 text-center font-semibold text-gray-700 hover:bg-gray-50 transition-colors"
        >
          Get Started
        </a>
      </div>

      <!-- Yearly Plan -->
      <div class="relative rounded-2xl border-2 border-primary-600 bg-white p-8 shadow-sm">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary-600 px-4 py-1 text-sm font-semibold text-white">
          Best Value
        </span>
        <h3 class="text-lg font-semibold text-gray-900">Yearly</h3>
        <p class="mt-2 text-gray-600">Save $100 with annual billing</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-gray-900">$500</span>
          <span class="text-gray-600">/year</span>
        </p>
        <p class="mt-1 text-sm text-green-600 font-medium">Save $100 compared to monthly</p>
        <ul class="mt-8 space-y-4 text-gray-600">
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Unlimited team members
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Unlimited messages
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            5 WhatsApp numbers
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Contact assignment
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Team collaboration
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Analytics dashboard
          </li>
        </ul>
        <a
          href="#"
          class="mt-8 block w-full rounded-lg bg-primary-600 py-3 text-center font-semibold text-white hover:bg-primary-700 transition-colors"
        >
          Get Started
        </a>
      </div>

      <!-- Enterprise Plan -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">Enterprise</h3>
        <p class="mt-2 text-gray-600">Custom hosting for your needs</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-gray-900">Custom</span>
        </p>
        <p class="mt-1 text-sm text-gray-500">Contact us for pricing</p>
        <ul class="mt-8 space-y-4 text-gray-600">
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Everything in paid plans
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Custom hosting
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Dedicated support
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Custom integrations
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            SLA guarantee
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            On-premise option
          </li>
        </ul>
        <a
          href="#"
          class="mt-8 block w-full rounded-lg border border-gray-300 bg-white py-3 text-center font-semibold text-gray-700 hover:bg-gray-50 transition-colors"
        >
          Contact Sales
        </a>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-24">
      <h2 class="text-center text-2xl font-bold text-gray-900">Frequently asked questions</h2>
      <div class="mx-auto mt-12 max-w-3xl divide-y divide-gray-200">
        <div class="py-6">
          <h3 class="text-lg font-semibold text-gray-900">What is included in all plans?</h3>
          <p class="mt-2 text-gray-600">
            Both Monthly and Yearly plans include unlimited team members, unlimited messages, 5 WhatsApp number connections, contact assignment, team collaboration features, and a full analytics dashboard.
          </p>
        </div>
        <div class="py-6">
          <h3 class="text-lg font-semibold text-gray-900">Can I add more WhatsApp numbers?</h3>
          <p class="mt-2 text-gray-600">
            The standard plans include 5 WhatsApp numbers. For more connections, please contact us for Enterprise pricing.
          </p>
        </div>
        <div class="py-6">
          <h3 class="text-lg font-semibold text-gray-900">Do you offer API access?</h3>
          <p class="mt-2 text-gray-600">
            API access is not included in our current plans. If you need API integration, please contact us to discuss Enterprise options.
          </p>
        </div>
        <div class="py-6">
          <h3 class="text-lg font-semibold text-gray-900">What payment methods do you accept?</h3>
          <p class="mt-2 text-gray-600">
            We accept all major credit cards and offer invoicing for Enterprise customers.
          </p>
        </div>
        <div class="py-6">
          <h3 class="text-lg font-semibold text-gray-900">Can I cancel anytime?</h3>
          <p class="mt-2 text-gray-600">
            Yes, you can cancel your subscription at any time. Your access will continue until the end of your billing period.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
