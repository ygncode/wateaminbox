---
import Layout from '../layouts/Layout.astro';
---

<Layout title="WATeamInbox - WhatsApp for Teams">
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
        WhatsApp for
        <span class="text-primary-600">Teams</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
        Collaborate with your team on WhatsApp. Manage multiple WhatsApp numbers, assign conversations, and work together seamlessly.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-amber-700">
        Open-source beta software for evaluation and self-hosting. Development defaults are not production-hardened.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <a
          href="#"
          class="rounded-lg bg-primary-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
        >
          Get Started
        </a>
        <a
          href="/docs"
          class="rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-700 shadow-sm hover:bg-gray-50"
        >
          Documentation
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-3xl font-bold text-gray-900">Features</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-gray-600">
        Everything you need to stay connected
      </p>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">Real-time Messaging</h3>
          <p class="mt-2 text-gray-600">Send and receive messages instantly with real-time synchronization.</p>
        </div>
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">Role-Based Access</h3>
          <p class="mt-2 text-gray-600">Scope conversations and administrative actions with workspace roles and assignments.</p>
        </div>
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">Cross-Platform</h3>
          <p class="mt-2 text-gray-600">Access your messages from any device, anywhere.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
