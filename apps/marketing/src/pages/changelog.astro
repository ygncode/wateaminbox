---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Changelog - WATeamInbox">
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Changelog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Stay up to date with the latest changes and improvements
      </p>
    </div>

    <div class="mt-16 space-y-12">
      <!-- Version 0.0.1 -->
      <article class="relative border-l-2 border-primary-600 pl-6">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary-600"></div>
        <time class="text-sm font-semibold text-primary-600">January 17, 2026</time>
        <h2 class="mt-2 text-xl font-bold text-gray-900">Version 0.0.1</h2>
        <p class="mt-4 text-gray-600">
          Initial pre-release of WATeamInbox. We're actively developing and improving the platform.
        </p>
        <ul class="mt-4 space-y-2 text-gray-600">
          <li>Team-based WhatsApp management</li>
          <li>Multi-number support (up to 5 WhatsApp numbers)</li>
          <li>Contact assignment and collaboration</li>
          <li>Real-time messaging synchronization</li>
          <li>Analytics and engagement tracking</li>
        </ul>
      </article>
    </div>
  </section>
</Layout>
