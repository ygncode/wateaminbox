---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Changelog - WhatsApp Web">
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Changelog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Stay up to date with the latest changes and improvements
      </p>
    </div>

    <div class="mt-16 space-y-12">
      <!-- Version 1.2.0 -->
      <article class="relative border-l-2 border-primary-600 pl-6">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary-600"></div>
        <time class="text-sm font-semibold text-primary-600">January 1, 2026</time>
        <h2 class="mt-2 text-xl font-bold text-gray-900">Version 1.2.0</h2>
        <ul class="mt-4 space-y-2 text-gray-600">
          <li>Added dark mode support</li>
          <li>Improved message search functionality</li>
          <li>Fixed notification issues on mobile browsers</li>
          <li>Performance improvements for large chat histories</li>
        </ul>
      </article>

      <!-- Version 1.1.0 -->
      <article class="relative border-l-2 border-gray-200 pl-6">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-gray-300"></div>
        <time class="text-sm font-semibold text-gray-500">December 15, 2025</time>
        <h2 class="mt-2 text-xl font-bold text-gray-900">Version 1.1.0</h2>
        <ul class="mt-4 space-y-2 text-gray-600">
          <li>Introduced group chat features</li>
          <li>Added emoji reactions to messages</li>
          <li>Improved file sharing capabilities</li>
          <li>Bug fixes and stability improvements</li>
        </ul>
      </article>

      <!-- Version 1.0.0 -->
      <article class="relative border-l-2 border-gray-200 pl-6">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-gray-300"></div>
        <time class="text-sm font-semibold text-gray-500">November 1, 2025</time>
        <h2 class="mt-2 text-xl font-bold text-gray-900">Version 1.0.0</h2>
        <ul class="mt-4 space-y-2 text-gray-600">
          <li>Initial release</li>
          <li>Real-time messaging</li>
          <li>End-to-end encryption</li>
          <li>Cross-platform support</li>
        </ul>
      </article>
    </div>
  </section>
</Layout>
