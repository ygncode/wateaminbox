---
import Layout from '../../layouts/Layout.astro';

const blogPosts = [
  {
    slug: 'introducing-whatsapp-business-labels-sync',
    title: 'Introducing WhatsApp Business Labels Sync',
    excerpt: 'Seamlessly sync your WhatsApp Business labels with custom tags for better organization and team collaboration.',
    date: 'January 3, 2026',
    category: 'Product Update',
    categoryColor: 'bg-primary-100 text-primary-800',
    image: '/blog/labels-sync.svg',
    readTime: '4 min read'
  },
  {
    slug: 'team-collaboration-best-practices',
    title: 'Team Collaboration Best Practices for WATeamInbox',
    excerpt: 'Learn how to effectively manage team collaboration, contact assignments, and customer communication workflows.',
    date: 'January 2, 2026',
    category: 'Guide',
    categoryColor: 'bg-emerald-100 text-emerald-800',
    image: '/blog/team-collaboration.svg',
    readTime: '6 min read'
  },
  {
    slug: 'understanding-customer-engagement-metrics',
    title: 'Understanding Customer Engagement Metrics',
    excerpt: 'Deep dive into engagement scores, response rates, and how to use analytics to improve customer relationships.',
    date: 'January 1, 2026',
    category: 'Analytics',
    categoryColor: 'bg-purple-100 text-purple-800',
    image: '/blog/analytics.svg',
    readTime: '5 min read'
  },
  {
    slug: 'security-best-practices-whatsapp-web',
    title: 'Security Best Practices for WATeamInbox',
    excerpt: 'Essential security tips to protect your business communications and customer data on WATeamInbox.',
    date: 'December 28, 2025',
    category: 'Security',
    categoryColor: 'bg-red-100 text-red-800',
    image: '/blog/security.svg',
    readTime: '7 min read'
  },
  {
    slug: 'quick-replies-boost-productivity',
    title: 'How Quick Replies Can Boost Your Team\'s Productivity',
    excerpt: 'Discover how to create and use quick reply templates to respond faster and maintain consistent messaging.',
    date: 'December 20, 2025',
    category: 'Tips & Tricks',
    categoryColor: 'bg-cyan-100 text-cyan-800',
    image: '/blog/quick-replies.svg',
    readTime: '4 min read'
  },
  {
    slug: 'getting-started-with-whatsapp-web',
    title: 'Getting Started with WATeamInbox',
    excerpt: 'A comprehensive guide to setting up your WATeamInbox account, connecting your WhatsApp, and starting your first conversation.',
    date: 'December 15, 2025',
    category: 'Getting Started',
    categoryColor: 'bg-blue-100 text-blue-800',
    image: '/blog/getting-started.svg',
    readTime: '8 min read'
  }
];

const categories = [
  { name: 'All', count: blogPosts.length },
  { name: 'Product Update', count: 1 },
  { name: 'Guide', count: 1 },
  { name: 'Analytics', count: 1 },
  { name: 'Security', count: 1 },
  { name: 'Tips & Tricks', count: 1 },
  { name: 'Getting Started', count: 1 }
];
---

<Layout title="Blog - WATeamInbox">
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Latest news, product updates, guides, and insights to help you get the most out of WATeamInbox.
      </p>
    </div>

    <!-- Categories Filter -->
    <div class="mt-12 flex flex-wrap justify-center gap-2" data-testid="category-filter">
      {categories.map((category, index) => (
        <button
          class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
            index === 0
              ? 'bg-primary-600 text-white'
              : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
          }`}
          data-testid={`category-${category.name.toLowerCase().replace(/\s+/g, '-')}`}
        >
          {category.name} ({category.count})
        </button>
      ))}
    </div>

    <!-- Featured Post -->
    <div class="mt-16" data-testid="featured-post">
      <article class="overflow-hidden rounded-2xl bg-gradient-to-r from-primary-600 to-primary-800 shadow-xl">
        <div class="grid gap-8 p-8 md:grid-cols-2 md:p-12">
          <div class="flex flex-col justify-center">
            <span class="inline-flex w-fit items-center rounded-full bg-white/20 px-3 py-1 text-sm font-medium text-white">
              Featured
            </span>
            <h2 class="mt-4 text-2xl font-bold text-white md:text-3xl">
              <a href={`/blog/${blogPosts[0].slug}`} class="hover:underline">
                {blogPosts[0].title}
              </a>
            </h2>
            <p class="mt-4 text-lg text-primary-100">
              {blogPosts[0].excerpt}
            </p>
            <div class="mt-6 flex items-center gap-4 text-sm text-primary-200">
              <time>{blogPosts[0].date}</time>
              <span>•</span>
              <span>{blogPosts[0].readTime}</span>
            </div>
            <a
              href={`/blog/${blogPosts[0].slug}`}
              class="mt-6 inline-flex w-fit items-center gap-2 rounded-lg bg-white px-6 py-3 font-medium text-primary-600 transition-colors hover:bg-primary-50"
            >
              Read Article
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          <div class="flex items-center justify-center">
            <div class="flex h-48 w-48 items-center justify-center rounded-2xl bg-white/10 md:h-64 md:w-64">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 text-white/60 md:h-32 md:w-32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Blog Grid -->
    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-testid="blog-grid">
      {blogPosts.slice(1).map((post) => (
        <article
          class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md"
          data-testid={`blog-post-${post.slug}`}
        >
          <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
            {post.category === 'Guide' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            )}
            {post.category === 'Analytics' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            )}
            {post.category === 'Security' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {post.category === 'Tips & Tricks' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {post.category === 'Getting Started' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            )}
          </div>
          <div class="p-6">
            <div class="flex items-center gap-3">
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${post.categoryColor}`}>
                {post.category}
              </span>
              <span class="text-sm text-gray-500">{post.readTime}</span>
            </div>
            <h2 class="mt-3 text-lg font-semibold text-gray-900 group-hover:text-primary-600">
              <a href={`/blog/${post.slug}`}>
                {post.title}
              </a>
            </h2>
            <p class="mt-2 line-clamp-2 text-gray-600">
              {post.excerpt}
            </p>
            <div class="mt-4 flex items-center justify-between">
              <time class="text-sm text-gray-500">{post.date}</time>
              <a
                href={`/blog/${post.slug}`}
                class="text-sm font-medium text-primary-600 hover:text-primary-700"
              >
                Read more →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Newsletter Signup -->
    <div class="mt-24 rounded-2xl bg-gray-50 p-8 md:p-12" data-testid="newsletter-section">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold text-gray-900 md:text-3xl">
          Stay updated with our newsletter
        </h2>
        <p class="mt-4 text-gray-600">
          Get the latest product updates, tips, and insights delivered straight to your inbox.
        </p>
        <form class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center" data-testid="newsletter-form">
          <label for="email-input" class="sr-only">Email address</label>
          <input
            id="email-input"
            type="email"
            placeholder="Enter your email"
            class="rounded-lg border border-gray-300 px-4 py-3 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 sm:w-80"
            data-testid="newsletter-email-input"
          />
          <button
            type="submit"
            class="rounded-lg bg-primary-600 px-6 py-3 font-medium text-white transition-colors hover:bg-primary-700"
            data-testid="newsletter-submit-button"
          >
            Subscribe
          </button>
        </form>
        <p class="mt-4 text-sm text-gray-500">
          No spam, unsubscribe at any time.
        </p>
      </div>
    </div>

    <!-- Pagination -->
    <div class="mt-16 flex justify-center" data-testid="pagination">
      <nav class="flex items-center gap-2">
        <button class="rounded-lg border border-gray-300 px-4 py-2 text-gray-500" disabled>
          Previous
        </button>
        <button class="rounded-lg bg-primary-600 px-4 py-2 text-white">1</button>
        <button class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50">2</button>
        <button class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50">
          Next
        </button>
      </nav>
    </div>
  </section>
</Layout>
