---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog - WhatsApp Web">
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Latest news, updates, and insights
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <!-- Blog Post Placeholder 1 -->
      <article class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="h-48 bg-gray-200"></div>
        <div class="p-6">
          <time class="text-sm text-gray-500">January 1, 2026</time>
          <h2 class="mt-2 text-xl font-semibold text-gray-900">
            <a href="#" class="hover:text-primary-600">Getting Started with WhatsApp Web</a>
          </h2>
          <p class="mt-2 text-gray-600">
            Learn how to set up and use WhatsApp Web for seamless messaging.
          </p>
        </div>
      </article>

      <!-- Blog Post Placeholder 2 -->
      <article class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="h-48 bg-gray-200"></div>
        <div class="p-6">
          <time class="text-sm text-gray-500">December 28, 2025</time>
          <h2 class="mt-2 text-xl font-semibold text-gray-900">
            <a href="#" class="hover:text-primary-600">Security Best Practices</a>
          </h2>
          <p class="mt-2 text-gray-600">
            Keep your messages secure with these essential tips.
          </p>
        </div>
      </article>

      <!-- Blog Post Placeholder 3 -->
      <article class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="h-48 bg-gray-200"></div>
        <div class="p-6">
          <time class="text-sm text-gray-500">December 20, 2025</time>
          <h2 class="mt-2 text-xl font-semibold text-gray-900">
            <a href="#" class="hover:text-primary-600">New Features Announcement</a>
          </h2>
          <p class="mt-2 text-gray-600">
            Discover the latest features we've added to improve your experience.
          </p>
        </div>
      </article>
    </div>
  </section>
</Layout>
