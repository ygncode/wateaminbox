---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Documentation - WhatsApp Web">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-4 lg:gap-8">
      <!-- Sidebar -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24">
          <h2 class="font-semibold text-gray-900">Documentation</h2>
          <ul class="mt-4 space-y-2">
            <li>
              <a href="#" class="text-primary-600">Getting Started</a>
            </li>
            <li>
              <a href="#" class="text-gray-600 hover:text-gray-900">Installation</a>
            </li>
            <li>
              <a href="#" class="text-gray-600 hover:text-gray-900">Configuration</a>
            </li>
            <li>
              <a href="#" class="text-gray-600 hover:text-gray-900">API Reference</a>
            </li>
            <li>
              <a href="#" class="text-gray-600 hover:text-gray-900">Examples</a>
            </li>
            <li>
              <a href="#" class="text-gray-600 hover:text-gray-900">FAQ</a>
            </li>
          </ul>
        </nav>
      </aside>

      <!-- Main Content -->
      <main class="lg:col-span-3">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900">Documentation</h1>
        <p class="mt-4 text-lg text-gray-600">
          Welcome to the WhatsApp Web documentation. Learn how to get started and make the most of our platform.
        </p>

        <section class="mt-12">
          <h2 class="text-2xl font-bold text-gray-900">Getting Started</h2>
          <p class="mt-4 text-gray-600">
            Follow these steps to get up and running with WhatsApp Web.
          </p>

          <div class="mt-6 rounded-lg bg-gray-50 p-6">
            <h3 class="font-semibold text-gray-900">Step 1: Create an Account</h3>
            <p class="mt-2 text-gray-600">
              Sign up for a free account to get started.
            </p>
          </div>

          <div class="mt-4 rounded-lg bg-gray-50 p-6">
            <h3 class="font-semibold text-gray-900">Step 2: Connect Your Device</h3>
            <p class="mt-2 text-gray-600">
              Link your mobile device by scanning the QR code.
            </p>
          </div>

          <div class="mt-4 rounded-lg bg-gray-50 p-6">
            <h3 class="font-semibold text-gray-900">Step 3: Start Messaging</h3>
            <p class="mt-2 text-gray-600">
              You're all set! Start sending and receiving messages.
            </p>
          </div>
        </section>

        <section class="mt-12">
          <h2 class="text-2xl font-bold text-gray-900">Need Help?</h2>
          <p class="mt-4 text-gray-600">
            If you have any questions, check out our <a href="#" class="text-primary-600 hover:underline">FAQ</a> or <a href="#" class="text-primary-600 hover:underline">contact support</a>.
          </p>
        </section>
      </main>
    </div>
  </div>
</Layout>
