---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — WATeamInbox"
  description="This WATeamInbox page could not be found. Return to the shared inbox project, self-hosting docs, or changelog."
>
  <section class="flex min-h-[60vh] items-center justify-center px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <!-- Chat bubble with single checkmark (undelivered) -->
      <div class="mx-auto mb-8 w-32">
        <svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
          <!-- Chat bubble -->
          <path
            d="M10 15C10 9.47715 14.4772 5 20 5H100C105.523 5 110 9.47715 110 15V65C110 70.5228 105.523 75 100 75H30L15 90V75H20C14.4772 75 10 70.5228 10 65V15Z"
            fill="#f0fdf4"
            stroke="#16a34a"
            stroke-width="2"
          />
          <!-- Single gray checkmark (not delivered) -->
          <path
            d="M45 42L55 52L75 32"
            stroke="#9ca3af"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <!-- Large subtle 404 -->
      <p class="text-8xl font-bold text-primary-600/20 md:text-9xl">404</p>

      <!-- Headline -->
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 md:text-3xl">
        Message not delivered
      </h1>

      <!-- Description -->
      <p class="mx-auto mt-4 max-w-md text-lg text-gray-600">
        The page you're looking for seems to have been lost in transit. It might have been moved, deleted, or never existed in the first place.
      </p>

      <!-- Primary CTA -->
      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center rounded-lg bg-primary-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-primary-700"
        >
          <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Home
        </a>
      </div>

      <!-- Quick links -->
      <div class="mt-12">
        <p class="text-sm font-medium text-gray-500">Or try one of these pages</p>
        <div class="mt-3 flex items-center justify-center gap-2 text-sm">
          <a href="/pricing" class="text-primary-600 hover:text-primary-700">Pricing</a>
          <span class="text-gray-300">·</span>
          <a href="/docs" class="text-primary-600 hover:text-primary-700">Documentation</a>
          <span class="text-gray-300">·</span>
          <a href="/blog" class="text-primary-600 hover:text-primary-700">Blog</a>
          <span class="text-gray-300">·</span>
          <a href="/changelog" class="text-primary-600 hover:text-primary-700">Changelog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
