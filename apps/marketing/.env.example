# This value is compiled into the static Astro site. Use the public Worker origin,
# not /api, unless you have deliberately configured a reverse proxy yourself.
PUBLIC_WAITLIST_API_URL=http://localhost:8787

# Optional public Cloudflare Turnstile site key. Set this only when the Worker
# is configured with the matching TURNSTILE_SECRET_KEY.
# PUBLIC_WAITLIST_TURNSTILE_SITE_KEY=
