{
  "name": "@wateaminbox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "bunx biome lint src",
    "format": "bunx biome format --write src",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@hono/zod-validator": "^0.7.6",
    "@wateaminbox/database": "workspace:*",
    "@wateaminbox/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.19",
    "fflate": "^0.8.2",
    "hono": "^4.12.33",
    "jose": "^6.1.3",
    "meilisearch": "^0.55.0",
    "nats": "^2.29.3",
    "pino": "^10.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2"
  }
}
