# Copy to .env.production. This file contains configuration and secret *paths*,
# never secret values. Compose aborts when any required value is absent.
COMPOSE_PROJECT_NAME=wateaminbox-production
APP_IMAGE_TAG=2026-08-02.1
# Optional independent worker image tag. The immutable on-volume version is
# derived from the packaged SHA-256 even when this or APP_IMAGE_TAG is mutable.
# WORKER_IMAGE_TAG=2026-08-02.1-worker.1
# Optional reviewed human-readable immutable label. Normally leave unset and
# use the generated sha256-<digest> version reported by the installer.
# WORKER_ARTIFACT_VERSION=2026-08-02.1-worker.1
# Bootstrap is the immutable first installed artifact used only when no
# completed rollout exists for a company. Changing this recreates the
# orchestrator; normally leave it unset as "bootstrap".
# WORKER_BOOTSTRAP_ARTIFACT_VERSION=bootstrap
# Authenticated/connected verification deadline per connection.
# WORKER_ROLLOUT_READY_TIMEOUT=2m

APP_DOMAIN=inbox.example.com
MEDIA_DOMAIN=media.example.com
ACME_EMAIL=ops@example.com
EMAIL_FROM=WATeamInbox <noreply@example.com>

POSTGRES_USER=wateaminbox
POSTGRES_DB=wateaminbox
# Existing private Cloudflare R2 bucket (APAC placement). Use the account-level
# S3 API endpoint; do not use r2.dev or a public/custom bucket domain.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=whatsapp-media
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Former path-style MinIO origins accepted when resolving persisted URLs. The
# API re-signs them against R2; no request is proxied from R2 back to MinIO.
S3_LEGACY_ENDPOINTS=https://media.example.com,http://minio:9000
S3_SIGNED_URL_TTL_SECONDS=300
# Mail provider: resend or cloudflare. Set the matching key file below; the
# other provider's variables stay unset and need no placeholder secret.
MAIL_DRIVER=resend
# Cloudflare Email Service only (MAIL_DRIVER=cloudflare): the 32-character
# account ID that owns the onboarded sender domain. Not a secret; the token is.
CLOUDFLARE_ACCOUNT_ID=
LOG_LEVEL=info

# Docker secret files: create each as mode 0600; use URL-safe random values.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
NATS_TOKEN_FILE=./secrets/nats_token
MEILISEARCH_MASTER_KEY_FILE=./secrets/meilisearch_master_key
MINIO_ROOT_USER_FILE=./secrets/minio_root_user
MINIO_ROOT_PASSWORD_FILE=./secrets/minio_root_password
# Newly scoped whatsapp-media R2 token files. Compose still mounts these as
# /run/secrets/s3_access_key and /run/secrets/s3_secret_key. Never reuse the
# backup-bucket credentials. Preserve the old MinIO s3_access_key/s3_secret_key
# files unchanged for rollback.
S3_ACCESS_KEY_FILE=/opt/wateaminbox/secrets/r2_media_access_key_id
S3_SECRET_KEY_FILE=/opt/wateaminbox/secrets/r2_media_secret_access_key
JWT_SECRET_FILE=./secrets/jwt_secret
CENTRIFUGO_API_KEY_FILE=./secrets/centrifugo_api_key
CENTRIFUGO_TOKEN_SECRET_FILE=./secrets/centrifugo_token_secret
# Exactly one of these, matching MAIL_DRIVER: it becomes the single
# /run/secrets/mail_api_key mount. Leave the unused one unset; setting both is
# refused at startup because one mount cannot be two providers' keys.
RESEND_API_KEY_FILE=./secrets/resend_api_key
# CLOUDFLARE_EMAIL_API_TOKEN_FILE=./secrets/cloudflare_email_api_token

# Optional web-push public key. Supplying push secrets requires adding them as
# Compose secrets and *_FILE variables; do not put the private key here.
VAPID_PUBLIC_KEY=

# Resource controls
# Worker admission cap — the approved project global cap is 15.
ORCHESTRATOR_MAX_WORKERS=15
# Worker DB pool (defaults: maxOpen=4, maxIdle=2, lifetime=5m, idleTime=2m).
# Inherited by child workers via the orchestrator's environment.
# WORKER_DB_MAX_OPEN_CONNS=4
# WORKER_DB_MAX_IDLE_CONNS=2
# WORKER_DB_CONN_MAX_LIFETIME=5m
# WORKER_DB_CONN_MAX_IDLE_TIME=2m
# Compose CPU/memory deploy limits are deferred until load-tested.

# Optional GA4 product analytics: public build configuration, not secrets (see
# docs/product-analytics.md). Values are compiled into the web image, so
# changing them requires rebuilding it. Active only when VITE_GA_ENABLED=true
# AND the ID is a valid GA4 web stream ID (G-XXXXXXXXXX) from your own GA4
# property. VITE_GA_REQUIRE_CONSENT=true (recommended) shows each visitor an
# in-app consent prompt before anything loads; setting it to false is an
# explicit operator policy decision requiring another consent/legal mechanism.
VITE_GA_ENABLED=false
VITE_GA_MEASUREMENT_ID=
VITE_GA_REQUIRE_CONSENT=true

# Change these only if this subnet overlaps the host network. Both must remain
# in sync so the API trusts forwarding headers only from Caddy.
EDGE_SUBNET=10.253.0.0/24
PROXY_IP=10.253.0.254
