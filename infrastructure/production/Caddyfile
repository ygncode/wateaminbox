{
	email {$ACME_EMAIL}
	admin 0.0.0.0:2019
	servers {
		# Keep these ranges synchronized with https://www.cloudflare.com/ips/.
		# Caddy ignores forwarding headers from every other public source.
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For X-Real-IP
	}
}

(common_security) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$APP_DOMAIN} {
	import common_security

	handle /api/* {
		reverse_proxy api-router:4451 {
			# Replace, rather than append to, any edge-provided chain. HAProxy
			# appends this Caddy hop before the API consumes the first address.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# OAuth discovery. RFC 8414 and RFC 9728 fix these paths at the root, so
	# they cannot be served under /api. Without this rule they fall through to
	# the SPA below and answer 200 with HTML, which an MCP client reads as a
	# malformed document rather than a missing one.
	handle /.well-known/oauth-* {
		reverse_proxy api-router:4451 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /connection/* {
		reverse_proxy centrifugo:8000
	}

	handle {
		reverse_proxy web:8080
	}
}
