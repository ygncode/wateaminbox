{
	email {$ACME_EMAIL}
	admin 0.0.0.0:2019
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

(common_security) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$APP_DOMAIN} {
	import common_security

	handle /api/* {
		reverse_proxy api:4445
	}

	handle /connection/* {
		reverse_proxy centrifugo:8000
	}

	handle {
		reverse_proxy web:8080
	}
}

{$MEDIA_DOMAIN} {
	import common_security
	# Legacy MinIO origin retained for migration rollback compatibility. New
	# signatures use R2's private S3 API directly. MinIO's console/admin API is
	# never routed, and this host can be removed after the rollback window.
	@admin path /minio/admin/*
	respond @admin 404
	reverse_proxy minio:9000
}
